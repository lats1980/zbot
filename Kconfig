config ENVIRONMENT_SENSOR
	bool "Environment sensor support"
	default n
	help
	  Enable the environment sensor device for reading temperature,
	  pressure, and humidity.

if ENVIRONMENT_SENSOR

config ENV_SENSOR_GAS_RES_SIM_BASE
	int "Base value of simulated gas resistance value"
	default 10000
	help
	  Gas resistance in Ohm that will be used as a baseline when simulating
	  gas resistance data.

config ENV_SENSOR_GAS_RES_SIM_MAX_DIFF
	int "Max difference from base value of simulated gas resistance"
	default 1000
	help
	  Maximum difference from the base value when simulating gas resistance
	  data.

endif # ENVIRONMENT_SENSOR

config DELAYED_WORK_SKILL
	bool "Delayed work skill support"
	default y
	help
	  Enable delayed work skill for scheduling LLM chat messages
	  with a time delay.

if DELAYED_WORK_SKILL

config DELAYED_WORK_MAX_ITEMS
	int "Maximum number of delayed work items"
	default 3
	range 1 100
	help
	  Maximum number of delayed work items that can be allocated
	  simultaneously. Each item consumes memory for storing the
	  message and work structure.

endif # DELAYED_WORK_SKILL

source "Kconfig.zephyr"
